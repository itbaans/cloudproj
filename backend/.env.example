# Chat Assistant Environment Configuration

# Add these variables to your backend/.env file:

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Instructions:
# 1. Get your Gemini API key from: https://ai.google.dev/
# 2. Replace 'your_gemini_api_key_here' with your actual API key
# 3. The model is set to gemini-1.5-flash for fast responses
# 4. You can change to gemini-1.5-pro for more advanced capabilities if needed
